# The console on the chip's own USB Serial/JTAG port rather than UART0, for a
# board whose only USB port is that one. Read after sdkconfig.defaults by the
# -usb builds in firmware.yml:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.usb" set-target esp32s3
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
