<?xml version="1.0" encoding="utf-8"?>
<!--
  cpcpub for Android: a window over the release's static Android binary, which
  rides in the APK as lib/arm64-v8a/libcpcpub.so. The version, the SDK levels
  and the signing come from build.sh.

  extractNativeLibs: the package manager copies the "library" out to the app's
  native library directory at install time, where Android lets an app execute
  a file, and copies it unchanged, so the digest the benchmark reports for
  itself is still the release asset's.

  usesCleartextTraffic: a hub may be a plain http:// server on a LAN, as the
  benchmark itself allows; the public hub is https.

  configChanges: turning the phone must not restart the activity, which would
  drop a run that is still measuring.

  RunService: held while a run measures, so leaving the app does not freeze it
  mid-measurement (see RunService.java). A foreground service of the special
  use type, with a wake lock for the screen going off; the notification
  permission only makes its notification visible.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="je.qd.cpcpub">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="cpcpub"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".RunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a CPU benchmark measuring until it finishes"/>
        </service>
    </application>
</manifest>
