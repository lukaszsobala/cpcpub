<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer: the benchmark, on PATH, and the window, in the Start
  menu. Built by build-msi.py with wixl (msitools), which takes this WiX 3
  source on Linux; the window's own folder is harvested into a second fragment
  there. Defines it expects:

    Version   the release, plain numbers and dots
    Arch      x64 or arm64: which machine the benchmark inside is for
    Bin       the release's cpcpub.exe for that machine
    BinV3     the x86-64-v3 build, or empty (arm64 has none)
    GuiDir    the PyInstaller folder of the window
    Top       the top of the source tree, for the icon and the license

  One installer layout serves both machines, and both are "x64" packages as
  far as Windows Installer is concerned: wixl cannot write an Arm64 package,
  and Windows 11 on Arm installs x64 ones. What differs is the benchmark, which
  is native to each machine. The window is the x64 one on both, and runs
  under emulation on Arm, where all it does is start the benchmark and read
  what it prints.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- The publisher without its diacritic: wixl writes a Manufacturer outside
       the database's code page as an empty string, whatever code page the
       database is given. -->
  <Product Id="*" Name="cpcpub" Language="1033" Version="$(var.Version)"
           Manufacturer="Lukasz Sobala"
           UpgradeCode="{9AEE9444-E73F-4541-9D53-98E29065DE0E}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="cpcpub $(var.Version), a CPU benchmark ($(var.Arch))"
             Comments="https://github.com/lukaszsobala/cpcpub"/>
    <Media Id="1" Cabinet="cpcpub.cab" EmbedCab="yes"/>

    <!-- One UpgradeCode for both machines, so installing a release replaces
         the one before it, and the launch condition below keeps the wrong
         one from being installed in the first place. -->
    <MajorUpgrade DowngradeErrorMessage="A newer cpcpub is already installed."/>

    <!-- The machine's own architecture, from the registry rather than from
         Windows Installer, which would answer for the x64 emulation an Arm
         machine runs this package's actions under. -->
    <Property Id="NATIVEARCH">
      <RegistrySearch Id="NativeArch" Root="HKLM" Type="raw" Win64="yes"
          Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
          Name="PROCESSOR_ARCHITECTURE"/>
    </Property>
<?if $(var.Arch) = "arm64" ?>
    <Condition Message="This is the cpcpub installer for 64-bit Arm Windows. This machine needs the x64 one.">Installed OR NATIVEARCH = "ARM64"</Condition>
<?else?>
    <!-- Refused on Arm, not merely discouraged: Windows would run the x64
         benchmark under emulation, and its results would look like numbers
         for the processor while measuring the emulator. -->
    <Condition Message="This is the cpcpub installer for 64-bit Intel and AMD Windows. On a 64-bit Arm machine, install the arm64 one: it runs the benchmark natively rather than under emulation.">Installed OR NATIVEARCH = "AMD64"</Condition>
<?endif?>

    <Icon Id="cpcpub.ico" SourceFile="$(var.Top)/packaging/icons/cpcpub.ico"/>
    <Property Id="ARPPRODUCTICON" Value="cpcpub.ico"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/lukaszsobala/cpcpub"/>
    <Property Id="ARPHELPLINK" Value="https://github.com/lukaszsobala/cpcpub/issues"/>
    <!-- There is nothing to choose, so nothing to modify. -->
    <Property Id="ARPNOMODIFY" Value="1"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="cpcpub">
          <!-- The release binary, byte for byte: a hub verifies a result by
               the digest of the file that measured it. -->
          <Component Id="Benchmark" Guid="*" Win64="yes">
            <File Id="cpcpub.exe" Name="cpcpub.exe" Source="$(var.Bin)" KeyPath="yes"/>
            <!-- On PATH, so `cpcpub` works from a new terminal, and off it
                 again on uninstall. The "-" in the name is that second half:
                 WiX writes it for Permanent="no", wixl ignores the attribute
                 and leaves the entry behind, and Windows Installer reads the
                 flags before a name in any order. -->
            <Environment Id="PathEntry" Name="-PATH" Value="[INSTALLDIR]"
                         Part="last" Action="set" System="yes" Permanent="no"/>
          </Component>
<?if $(var.BinV3) != "" ?>
          <Component Id="BenchmarkV3" Guid="*" Win64="yes">
            <File Id="cpcpub_v3.exe" Name="cpcpub-v3.exe" Source="$(var.BinV3)" KeyPath="yes"/>
          </Component>
<?endif?>
          <Component Id="Docs" Guid="*" Win64="yes">
            <File Id="LICENSE.txt" Name="LICENSE.txt" Source="$(var.Top)/LICENSE" KeyPath="yes"/>
            <File Id="README.md" Name="README.md" Source="$(var.Top)/bench/README.md"/>
          </Component>
          <Directory Id="GUIDIR" Name="gui"/>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenu" Guid="{24A4AA6A-3F20-4658-8B21-1C90E444187F}" Win64="yes">
          <Shortcut Id="GuiShortcut" Name="cpcpub"
                    Description="Measure the processor's cores and compare the results"
                    Target="[GUIDIR]cpcpub-gui.exe" WorkingDirectory="GUIDIR"/>
          <!-- A shortcut cannot be a component's key path; this value is. -->
          <RegistryValue Root="HKLM" Key="Software\cpcpub" Name="StartMenuShortcut"
                         Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Complete" Level="1">
      <ComponentRef Id="Benchmark"/>
<?if $(var.BinV3) != "" ?>
      <ComponentRef Id="BenchmarkV3"/>
<?endif?>
      <ComponentRef Id="Docs"/>
      <ComponentRef Id="StartMenu"/>
      <ComponentGroupRef Id="Gui"/>
    </Feature>
  </Product>
</Wix>
